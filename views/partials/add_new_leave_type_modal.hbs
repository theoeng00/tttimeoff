


<div class="modal fade" id="{{container_id}}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
    <form id="leave_type_new_form" method="POST" action="{{form_action}}">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="{{__ "Close"}}"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">{{__ "Add new Leave Type"}}</h4>
      </div>

      <div class="modal-body">

        <div class="form-group">
          <label for="leave_type_name_new" class="control-label">{{__ "Name:"}}</label>
          <input type="text" class="form-control" id="leave_type_name_new" name="name__new" required>
        </div>

        <div class="form-group">
          <input type="checkbox" id="leave_type_use_allovance_new" name="use_allowance__new">&nbsp;
          <label for="leave_type_use_allovance_new" class="control-label">{{__ "Use allowance"}}</label>
          <p><em>{{__ "If checked, this leave type will be deducted from the employee's annual allowance."}}</em></p>
        </div>

        <div class="form-group">
          <input type="checkbox" id="leave_type_auto_approve_new" name="auto_approve__new">&nbsp;
          <label for="leave_type_auto_approve_new" class="control-label">{{__ "Auto approve"}}</label>
          <p><em>{{__ "If checked, this leave type will not require manager approval."}}</em></p>
        </div>

        <div class="form-group">
          <div class="dropdown" data-tom-color-picker="1">
            <input type="hidden" name="color__new" value="leave_type_color_1">
            <button type="button" class="btn btn-default dropdown-toggle leave_type_color_1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-paint-brush"></i> {{__ "Choose a color for the new leave type"}}</button>
            <ul class="dropdown-menu">
              {{> options_for_color_picker}}
            </ul>
          </div>
          <p><em>{{__ "This color identifies the leave type on the Calendar and Team View pages."}}</em></p>
        </div>



        <div class="form-group">
          <label for="leave_type_limit_new" class="control-label">{{__ "Limit:"}}</label>
          <input type="number" class="form-control" id="leave_type_limit_new" name="limit__new">
          <p><em>{{__ "Enter a value greater than zero to limit how many days each employee can take per year."}}</em></p>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link" data-dismiss="modal">{{__ "Cancel"}}</button>
        <button type="submit" class="btn btn-success single-click">{{__ "Create"}}</button>
      </div>
    </form>
    </div>
  </div>
</div>


