{{> header}}
<h1>{{__ "Attendance settings"}}</h1>
{{> show_flash_messages}}

<form method="post" action="/attendance/settings/" class="form-horizontal">
  <div class="checkbox"><label><input type="checkbox" name="attendance_enabled" {{#if company.attendance_enabled}}checked{{/if}}> {{__ "Enable attendance system"}}</label></div>
  <div class="form-group"><label class="col-sm-3 control-label">{{__ "Verification method"}}</label><div class="col-sm-6"><p class="form-control-static">GPS</p></div></div>
  <div class="form-group"><label class="col-sm-3 control-label" for="location-name">{{__ "Work location name"}}</label><div class="col-sm-6"><input class="form-control" id="location-name" name="attendance_location_name" maxlength="100" value="{{company.attendance_location_name}}"></div></div>
  <div class="form-group"><label class="col-sm-3 control-label" for="latitude">{{__ "Latitude"}}</label><div class="col-sm-3"><input class="form-control" id="latitude" name="attendance_latitude" type="number" step="0.0000001" min="-90" max="90" value="{{company.attendance_latitude}}"></div><label class="col-sm-2 control-label" for="longitude">{{__ "Longitude"}}</label><div class="col-sm-3"><input class="form-control" id="longitude" name="attendance_longitude" type="number" step="0.0000001" min="-180" max="180" value="{{company.attendance_longitude}}"></div></div>
  <div class="form-group"><div class="col-sm-offset-3 col-sm-8"><button class="btn btn-default" type="button" id="use-current-location"><span class="fa fa-map-marker" aria-hidden="true"></span> {{__ "Use my current location"}}</button> <span id="settings-gps-status" role="status" aria-live="polite"></span></div></div>
  <div class="form-group"><label class="col-sm-3 control-label" for="radius">{{__ "Allowed radius (metres)"}}</label><div class="col-sm-3"><input class="form-control" id="radius" name="attendance_radius_m" type="number" min="20" max="5000" value="{{company.attendance_radius_m}}" required></div></div>
  <div class="form-group"><label class="col-sm-3 control-label" for="start-time">{{__ "Start time"}}</label><div class="col-sm-3"><input class="form-control" id="start-time" name="attendance_start_time" type="time" value="{{company.attendance_start_time}}" required></div><label class="col-sm-2 control-label" for="end-time">{{__ "End time"}}</label><div class="col-sm-3"><input class="form-control" id="end-time" name="attendance_end_time" type="time" value="{{company.attendance_end_time}}" required></div></div>
  <div class="form-group"><label class="col-sm-3 control-label" for="grace">{{__ "Late grace period (minutes)"}}</label><div class="col-sm-3"><input class="form-control" id="grace" name="attendance_grace_minutes" type="number" min="0" max="180" value="{{company.attendance_grace_minutes}}" required></div><label class="col-sm-2 control-label" for="ot-after">{{__ "OT threshold (minutes)"}}</label><div class="col-sm-3"><input class="form-control" id="ot-after" name="attendance_ot_after_minutes" type="number" min="0" max="360" value="{{company.attendance_ot_after_minutes}}" required></div></div>
  <button class="btn btn-success pull-right single-click" type="submit">{{__ "Save changes"}}</button>
</form>
{{> footer}}
